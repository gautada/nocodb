RUN chown -R $USER:$USER /home/$USER
USER $USER
VOLUME /mnt/volumes/backup
VOLUME /mnt/volumes/configmaps
VOLUME /mnt/volumes/container
VOLUME /mnt/volumes/secrets
VOLUME /mnt/volumes/logs
VOLUME /mnt/volumes/source
EXPOSE 8080/tcp
WORKDIR /home/$USER
